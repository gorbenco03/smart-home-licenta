# ── Baza de date (PostgreSQL standard — fără TimescaleDB pe RPi) ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smarthome_db
DB_USER=smarthome
DB_PASS=smarthome_pass_2026

# ── MQTT ──
MQTT_URL=mqtt://localhost:1883
MQTT_USER=smarthome
MQTT_PASS=smarthome_mqtt_2026

# ── JWT ──
JWT_SECRET=schimba_asta_cu_un_sir_lung_random_minim_32_caractere
JWT_EXPIRES=7d

# ── Server ──
PORT=3000
NODE_ENV=development

# ── Simulator date (true = generează date fără senzori fizici) ──
SIMULATE=true
SIMULATE_INTERVAL_MS=5000
DEFAULT_USER=admin
DEFAULT_PASS=admin123
